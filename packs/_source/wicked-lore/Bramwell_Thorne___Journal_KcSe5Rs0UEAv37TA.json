  "flags": {
    "campaign-codex": {
      "type": "backstory",
      "data": {
        "description": "<h2>Family</h2><div class=\"wicked-family-grid\">\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Social Standing</div>\n        <div class=\"card-value\">Respected craftspeople (blacksmiths, masons, weavers).</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Childhood</div>\n        <div class=\"card-value\">Experienced prejudice or discrimination due to their race or heritage</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Parents Status</div>\n        <div class=\"card-value\">Both alive and well.</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Family Standing</div>\n        <div class=\"card-value\">Secure, even amid hardship.</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Family Goal</div>\n        <div class=\"card-value\">Restore the family name after generations of disgrace.</div>\n      </div></div>\n    <div class=\"wicked-parent-grid\">\n      <div class=\"wicked-parent-card\">\n        <div class=\"parent-role\">Mother</div>\n        <div class=\"parent-name\">Jynara</div>\n        <div class=\"parent-details\">\n          <p><strong>Relationship/Bond:</strong> You love and care for each other equally</p>\n        </div>\n      </div>\n      <div class=\"wicked-parent-card\">\n        <div class=\"parent-role\">Father</div>\n        <div class=\"parent-name\">Selovin</div>\n        <div class=\"parent-details\">\n          <p><strong>Relationship/Bond:</strong> You actively hate each other</p>\n        </div>\n      </div>\n    </div><p><strong>Birth order:</strong> 7th of 7 children.</p><div class=\"wicked-sibling-grid\">\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Aerandor</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">1st Child</span>\n              <span class=\"sibling-tag-pill\">older brother</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling is your bitter rival, competing for inheritance or glory.</p>\n              <p><strong>Relationship:</strong> You have a strange co-dependent relationship</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Caerin</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">2nd Child</span>\n              <span class=\"sibling-tag-pill\">older brother</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling was branded a criminal under mysterious and dubious circumstances.</p>\n              <p><strong>Relationship:</strong> You care for them more than they care for you</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Zaela</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">3rd Child</span>\n              <span class=\"sibling-tag-pill\">older sister</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling has a powerful but dangerous magical or supernatural gift.</p>\n              <p><strong>Relationship:</strong> You love and care for each other equally</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Aerandor</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">4th Child</span>\n              <span class=\"sibling-tag-pill\">older brother</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling vanished years ago. All they left was a blank journal and frayed purple ribbon.</p>\n              <p><strong>Relationship:</strong> One of you is going to kill the other someday</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Veda</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">5th Child</span>\n              <span class=\"sibling-tag-pill\">older sister</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling fell in with cultists devoted to an nihilistic god.</p>\n              <p><strong>Relationship:</strong> You care for each other but constantly bicker</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Faeldrin</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">6th Child</span>\n              <span class=\"sibling-tag-pill\">older brother</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling is a renowned wizard studying in a distant arcane academy.</p>\n              <p><strong>Relationship:</strong> You dislike each other greatly</p>\n            </div>\n          </div></div><h2>Friends &amp; Enemies</h2><h3>Friends</h3><div class=\"wicked-fe-grid\">\n      <div class=\"wicked-fe-card is-friend\">\n        <div class=\"fe-name\">Elarion Brightmoor</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">male</span> <span class=\"fe-tag-pill\">Shapeshifter / Changeling</span> <span class=\"fe-tag-pill\">Pirate / Privateer</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> You have a lifelong friend who always seems to show up exactly when you need them.</p>\n        </div>\n      </div>\n      <div class=\"wicked-fe-card is-friend\">\n        <div class=\"fe-name\">Selorin Harrowvale</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">male</span> <span class=\"fe-tag-pill\">Tiefling / Fiend-Blooded</span> <span class=\"fe-tag-pill\">Gang Leader / Crime Boss</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> You made a powerful enemy after defending a friend in a duel.</p>\n        </div>\n      </div>\n      <div class=\"wicked-fe-card is-friend\">\n        <div class=\"fe-name\">Kyara Ironwood</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">female</span> <span class=\"fe-tag-pill\">Halfling / Hobbit-like</span> <span class=\"fe-tag-pill\">Cult Leader / Dark Visionary</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> A former friend is now a rising noble and pretends not to know you.</p>\n        </div>\n      </div></div><h3>Enemies</h3><div class=\"wicked-fe-grid\">\n      <div class=\"wicked-fe-card is-enemy\">\n        <div class=\"fe-name\">Naerin Jadeston</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">male</span> <span class=\"fe-tag-pill\">Goblin</span> <span class=\"fe-tag-pill\">Alchemist / Poisoner</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> An assassin failed to kill you—and now takes it personally.</p>\n        </div>\n      </div>\n      <div class=\"wicked-fe-card is-enemy\">\n        <div class=\"fe-name\">Faeron Brightwell</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">male</span> <span class=\"fe-tag-pill\">Orc</span> <span class=\"fe-tag-pill\">Blacksmith / Weaponsmith (used for crafting traps or weapons)</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> A noble house seeks revenge for an insult you (or your family) made.</p>\n        </div>\n      </div>\n      <div class=\"wicked-fe-card is-enemy\">\n        <div class=\"fe-name\">Nessa Ravenholm</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">female</span> <span class=\"fe-tag-pill\">Human</span> <span class=\"fe-tag-pill\">Blacksmith / Weaponsmith (used for crafting traps or weapons)</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> A knight you defeated in honorable combat swore vengeance.</p>\n        </div>\n      </div></div><h2>Romance</h2>\n      <div class=\"wicked-family-grid\">\n        <div class=\"wicked-family-card\">\n          <div class=\"card-label\">Romance Status</div>\n          <div class=\"card-value\"><strong>Currently in a healthy romance</strong> — You fall in love with a stranger from another culture, overcoming societal expectations.</div>\n        </div>\n      </div>\n        <div class=\"wicked-partner-card\">\n          <div class=\"partner-role\">Lover</div>\n          <div class=\"partner-name\">Jynara Underwood</div>\n          <div class=\"partner-header\"><span class=\"partner-tag-pill\">female</span> <span class=\"partner-tag-pill\">Shapeshifter / Changeling</span> <span class=\"partner-tag-pill\">Bounty Hunter</span></div>\n          <div class=\"partner-details\" style=\"margin-top: 0.5rem;\">\n            <p><strong>Appearance:</strong> Unconventionally attractive—distinctive features that grow more captivating the longer you look.</p>\n          </div>\n        </div><h2>Faith</h2>\n        <div class=\"wicked-faith-card\">\n          <div class=\"faith-role\">Deity</div>\n          <div class=\"faith-name\">Seraphina</div>\n          <div class=\"faith-details\">\n            <p>Goddess of mercy and healing, her temples are the only places enemies may share bread without weapons drawn.</p>\n          </div>\n        </div><h2>Personality</h2>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Persona &amp; Values</div>\n        <div class=\"card-value\" style=\"margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.25rem;\">\n          <p><strong>Defining trait:</strong> Bold risk-taker, always seeking adventure</p><p><strong>Values most:</strong> Nature, animals, or the environment</p><p><strong>Most valued object:</strong> A trinket from a childhood friend or mentor</p><p><strong>If it were lost:</strong> They seek revenge against whoever took or destroyed it.</p><p><strong>Greatest fear:</strong> Spiders. Spiders can go F$@3 themselves.</p><p><strong>Person they value most:</strong> A sibling-in-law or extended family member</p><p><strong>Quirk:</strong> Apologizes profusely after winning an argument or fight.</p>\n        <div class=\"personality-trait-pairs\" style=\"margin-top: 0.75rem; border-top: 1px solid rgba(201, 160, 84, 0.15); padding-top: 0.5rem;\">\n          <strong style=\"font-size: 0.75rem; text-transform: uppercase; color: var(--dnd5e-color-gold-dim, #9a7d2e); letter-spacing: 0.05em;\">Trait Pairs</strong>\n          <ul style=\"margin: 0.25rem 0 0; padding-left: 1.25rem; font-size: 0.85rem;\">\n            <li><strong>Amorous / Chaste:</strong> 19 / 1</li><li><strong>Forgiving / Vengeful:</strong> 7 / 13</li><li><strong>Generous / Selfish:</strong> 17 / 3</li><li><strong>Honest / Deceitful:</strong> 1 / 19</li><li><strong>Just / Arbitrary:</strong> 20 / 0</li><li><strong>Merciful / Cruel:</strong> 19 / 1</li><li><strong>Modest / Proud:</strong> 18 / 2</li><li><strong>Prudent / Reckless:</strong> 18 / 2</li><li><strong>Temperate / Indulgent:</strong> 4 / 16</li><li><strong>Trusting / Suspicious:</strong> 12 / 8</li>\n          </ul>\n        </div>\n        </div>\n      </div><h2>Life Events</h2><div class=\"wicked-event-grid\">\n        <div class=\"wicked-event-card is-lucky\">\n          <div class=\"event-title\">Event 1</div>\n          <div class=\"event-header\">\n            <span class=\"event-tag-pill\">Lucky Event</span>\n          </div>\n          <div class=\"event-text\" style=\"margin-top: 0.5rem;\">\n            Inherited a minor magical heirloom from family\n          </div>\n        </div>\n        <div class=\"wicked-event-card is-unlucky\">\n          <div class=\"event-title\">Event 2</div>\n          <div class=\"event-header\">\n            <span class=\"event-tag-pill\">Unlucky Event</span>\n          </div>\n          <div class=\"event-text\" style=\"margin-top: 0.5rem;\">\n            Forced to abandon a mentor or teacher in danger\n          </div>\n        </div>\n        <div class=\"wicked-event-card is-unlucky\">\n          <div class=\"event-title\">Event 3</div>\n          <div class=\"event-header\">\n            <span class=\"event-tag-pill\">Unlucky Event</span>\n          </div>\n          <div class=\"event-text\" style=\"margin-top: 0.5rem;\">\n            Lost trust of companions or allies\n          </div>\n        </div></div>"
      },
      "icon-override": "fas fa-book-skull"
    },
