  "flags": {
    "campaign-codex": {
      "type": "backstory",
      "data": {
        "description": "<h2>Family</h2><div class=\"wicked-family-grid\">\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Social Standing</div>\n        <div class=\"card-value\">High-ranking clergy in a major faith (a god of justice, love, or war) believes you are the key to a prophecy.</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Childhood</div>\n        <div class=\"card-value\">Grew up as an orphan, raised by strangers or the streets</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Parents Status</div>\n        <div class=\"card-value\">They were executed after being falsely accused of treason against the crown. They are still in prison.</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Family Standing</div>\n        <div class=\"card-value\">Secure, even amid hardship.</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Family Goal</div>\n        <div class=\"card-value\">Gain favor with a powerful love deity.</div>\n      </div></div>\n    <div class=\"wicked-parent-grid\">\n      <div class=\"wicked-parent-card\">\n        <div class=\"parent-role\">Mother</div>\n        <div class=\"parent-name\">Seraphine</div>\n        <div class=\"parent-details\">\n          <p><strong>Relationship/Bond:</strong> You care for them more than they care for you</p>\n        </div>\n      </div>\n      <div class=\"wicked-parent-card\">\n        <div class=\"parent-role\">Father</div>\n        <div class=\"parent-name\">Calavin</div>\n        <div class=\"parent-details\">\n          <p><strong>Relationship/Bond:</strong> They care for you more than you care for them</p>\n        </div>\n      </div>\n    </div><p><strong>Birth order:</strong> 5th of 7 children.</p><div class=\"wicked-sibling-grid\">\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Freya</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">1st Child</span>\n              <span class=\"sibling-tag-pill\">older sister</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling is a devoted cleric of a powerful love, war, or law god.</p>\n              <p><strong>Relationship:</strong> You care for them more than they care for you</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Syloran</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">2nd Child</span>\n              <span class=\"sibling-tag-pill\">older brother</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling is a renowned wizard studying in a distant arcane academy.</p>\n              <p><strong>Relationship:</strong> You love and care for each other equally</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Elorin</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">3rd Child</span>\n              <span class=\"sibling-tag-pill\">older brother</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling has sworn vengeance against your family for a perceived betrayal.</p>\n              <p><strong>Relationship:</strong> You care for each other but constantly bicker</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Thessara</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">4th Child</span>\n              <span class=\"sibling-tag-pill\">older sister</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling fell in with cultists devoted to an nihilistic god.</p>\n              <p><strong>Relationship:</strong> You love and care for each other equally</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Gavril</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">6th Child</span>\n              <span class=\"sibling-tag-pill\">younger brother</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling is your bitter rival, competing for inheritance or glory.</p>\n              <p><strong>Relationship:</strong> You have a strange co-dependent relationship</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Phaedra</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">7th Child</span>\n              <span class=\"sibling-tag-pill\">younger sister</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling is so bland and meek that they are nigh invisible to even you and your family.</p>\n              <p><strong>Relationship:</strong> You love each other a little too much...</p>\n            </div>\n          </div></div><h2>Friends &amp; Enemies</h2><h3>Friends</h3><div class=\"wicked-fe-grid\">\n      <div class=\"wicked-fe-card is-friend\">\n        <div class=\"fe-name\">Raevon Xelrath</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">male</span> <span class=\"fe-tag-pill\">Half-Elf / Half-Blood</span> <span class=\"fe-tag-pill\">Thief / Burglar</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> A former friend is now a rising noble and pretends not to know you.</p>\n        </div>\n      </div></div><h3>Enemies</h3><div class=\"wicked-fe-grid\">\n      <div class=\"wicked-fe-card is-enemy\">\n        <div class=\"fe-name\">Yreneth Jadenmoor</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">female</span> <span class=\"fe-tag-pill\">Shapeshifter / Changeling</span> <span class=\"fe-tag-pill\">Beastmaster / Hunter</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> A cult devoted to an evil god believes you interfered with their plans.</p>\n        </div>\n      </div></div><h2>Romance</h2>\n      <div class=\"wicked-family-grid\">\n        <div class=\"wicked-family-card\">\n          <div class=\"card-label\">Romance Status</div>\n          <div class=\"card-value\"><strong>Recovering from a romantic disaster</strong> — Your first love died heroically in a battle you couldn’t prevent.</div>\n        </div>\n      </div>\n        <div class=\"wicked-partner-card is-tragic\">\n          <div class=\"partner-role\">Lost Lover</div>\n          <div class=\"partner-name\">Solen Hawkridge</div>\n          <div class=\"partner-header\"><span class=\"partner-tag-pill\">neutral</span> <span class=\"partner-tag-pill\">Half-Orc / Half-Giant</span> <span class=\"partner-tag-pill\">Bounty Hunter</span></div>\n          <div class=\"partner-details\" style=\"margin-top: 0.5rem;\">\n            <p><strong>Appearance:</strong> Graceful posture and dancer’s physique, moving like flowing water.</p>\n          </div>\n        </div><h2>Faith</h2>\n        <div class=\"wicked-faith-card\">\n          <div class=\"faith-role\">Deity</div>\n          <div class=\"faith-name\">Thromos</div>\n          <div class=\"faith-details\">\n            <p>God of storms and the merciless deep, he does not hear prayers from drowning sailors.</p>\n          </div>\n        </div><h2>Personality</h2>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Persona &amp; Values</div>\n        <div class=\"card-value\" style=\"margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.25rem;\">\n          <p><strong>Defining trait:</strong> Gentle and nurturing</p><p><strong>Values most:</strong> Faith or devotion to a deity or cause</p><p><strong>Most valued object:</strong> A crafted item they made themselves</p><p><strong>If it were lost:</strong> They lash out in anger at anyone nearby or involved.</p><p><strong>Greatest fear:</strong> Poverty or destitution</p><p><strong>Person they value most:</strong> A healer or caretaker who helped them recover from injury or trauma</p><p><strong>Quirk:</strong> Refers to themselves in the third person when stressed.</p>\n        <div class=\"personality-trait-pairs\" style=\"margin-top: 0.75rem; border-top: 1px solid rgba(201, 160, 84, 0.15); padding-top: 0.5rem;\">\n          <strong style=\"font-size: 0.75rem; text-transform: uppercase; color: var(--dnd5e-color-gold-dim, #9a7d2e); letter-spacing: 0.05em;\">Trait Pairs</strong>\n          <ul style=\"margin: 0.25rem 0 0; padding-left: 1.25rem; font-size: 0.85rem;\">\n            <li><strong>Amorous / Chaste:</strong> 18 / 2</li><li><strong>Forgiving / Vengeful:</strong> 3 / 17</li><li><strong>Generous / Selfish:</strong> 14 / 6</li><li><strong>Honest / Deceitful:</strong> 14 / 6</li><li><strong>Just / Arbitrary:</strong> 8 / 12</li><li><strong>Merciful / Cruel:</strong> 0 / 20</li><li><strong>Modest / Proud:</strong> 17 / 3</li><li><strong>Prudent / Reckless:</strong> 9 / 11</li><li><strong>Temperate / Indulgent:</strong> 12 / 8</li><li><strong>Trusting / Suspicious:</strong> 3 / 17</li>\n          </ul>\n        </div>\n        </div>\n      </div><h2>Life Events</h2><div class=\"wicked-event-grid\">\n        <div class=\"wicked-event-card is-lucky\">\n          <div class=\"event-title\">Event 1</div>\n          <div class=\"event-header\">\n            <span class=\"event-tag-pill\">Lucky Event</span>\n          </div>\n          <div class=\"event-text\" style=\"margin-top: 0.5rem;\">\n            Found a magic gold coin that always returns to your left pocket within 3 days of being separated from it.\n          </div>\n        </div>\n        <div class=\"wicked-event-card is-lucky\">\n          <div class=\"event-title\">Event 2</div>\n          <div class=\"event-header\">\n            <span class=\"event-tag-pill\">Lucky Event</span>\n          </div>\n          <div class=\"event-text\" style=\"margin-top: 0.5rem;\">\n            Tamed a magical or rare animal companion\n          </div>\n        </div>\n        <div class=\"wicked-event-card is-unlucky\">\n          <div class=\"event-title\">Event 3</div>\n          <div class=\"event-header\">\n            <span class=\"event-tag-pill\">Unlucky Event</span>\n          </div>\n          <div class=\"event-text\" style=\"margin-top: 0.5rem;\">\n            Suffered public humiliation or ridicule\n          </div>\n        </div></div>"
      },
      "icon-override": "fas fa-book-skull"
    },
