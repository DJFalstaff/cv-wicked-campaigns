  "flags": {
    "campaign-codex": {
      "type": "backstory",
      "data": {
        "description": "<h2>Family</h2><div class=\"wicked-family-grid\">\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Social Standing</div>\n        <div class=\"card-value\">Scholars or minor clergy serving a local temple.</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Childhood</div>\n        <div class=\"card-value\">Witnessed or survived a raid or attack on their town</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Parents Status</div>\n        <div class=\"card-value\">They were turned into undead and now wander as wights or revenants.</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Family Standing</div>\n        <div class=\"card-value\">At risk — An arranged marriage threatens to tie your family to a dangerous house.</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Family Goal</div>\n        <div class=\"card-value\">Avenge an ancestor who was betrayed and slain.</div>\n      </div></div>\n    <div class=\"wicked-parent-grid\">\n      <div class=\"wicked-parent-card\">\n        <div class=\"parent-role\">Mother</div>\n        <div class=\"parent-name\">Phaedra</div>\n        <div class=\"parent-details\">\n          <p><strong>Relationship/Bond:</strong> They care for you more than you care for them</p>\n        </div>\n      </div>\n      <div class=\"wicked-parent-card\">\n        <div class=\"parent-role\">Father</div>\n        <div class=\"parent-name\">Silvain</div>\n        <div class=\"parent-details\">\n          <p><strong>Relationship/Bond:</strong> You love and care for each other equally</p>\n        </div>\n      </div>\n    </div><p><strong>Birth order:</strong> 6th of 7 children.</p><div class=\"wicked-sibling-grid\">\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Alardin</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">1st Child</span>\n              <span class=\"sibling-tag-pill\">older brother</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling is a renowned wizard studying in a distant arcane academy.</p>\n              <p><strong>Relationship:</strong> One of you is going to kill the other someday</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Niven</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">2nd Child</span>\n              <span class=\"sibling-tag-pill\">older brother</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling is a decorated war hero—and expects you to measure up.</p>\n              <p><strong>Relationship:</strong> You love and care for each other equally</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Evander</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">3rd Child</span>\n              <span class=\"sibling-tag-pill\">older brother</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> A sibling joined a secretive faction no one believes exists.</p>\n              <p><strong>Relationship:</strong> You care for each other but constantly bicker</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Niven</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">4th Child</span>\n              <span class=\"sibling-tag-pill\">older brother</span> <span class=\"sibling-tag-pill half\">half-sibling</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling idolizes you and think you are better than you are.</p>\n              <p><strong>Relationship:</strong> You love and care for each other equally</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Calindar</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">5th Child</span>\n              <span class=\"sibling-tag-pill\">older brother</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling has a powerful but dangerous magical or supernatural gift.</p>\n              <p><strong>Relationship:</strong> You have a strange co-dependent relationship</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Xaela</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">7th Child</span>\n              <span class=\"sibling-tag-pill\">younger sister</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling and you share a magical link—when one is harmed, the other feels it.</p>\n              <p><strong>Relationship:</strong> You love and care for each other equally</p>\n            </div>\n          </div></div><h2>Friends &amp; Enemies</h2><h3>Friends</h3><div class=\"wicked-fe-grid\">\n      <div class=\"wicked-fe-card is-friend\">\n        <div class=\"fe-name\">Naelor Goldstone</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">male</span> <span class=\"fe-tag-pill\">Undead (Skeleton, Vampire, Wight, etc.)</span> <span class=\"fe-tag-pill\">Alchemist / Poisoner</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> You made a powerful enemy after defending a friend in a duel.</p>\n        </div>\n      </div></div><h3>Enemies</h3><div class=\"wicked-fe-grid\">\n      <div class=\"wicked-fe-card is-enemy\">\n        <div class=\"fe-name\">Caelan Keldorn</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">male</span> <span class=\"fe-tag-pill\">Shapeshifter / Changeling</span> <span class=\"fe-tag-pill\">Thief / Burglar</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> A member of the a secret society considers you a threat to their cause.</p>\n        </div>\n      </div></div><h2>Romance</h2>\n      <div class=\"wicked-family-grid\">\n        <div class=\"wicked-family-card\">\n          <div class=\"card-label\">Romance Status</div>\n          <div class=\"card-value\"><strong>On the lookout for love</strong></div>\n        </div>\n      </div><h2>Faith</h2>\n        <div class=\"wicked-faith-card\">\n          <div class=\"faith-role\">Deity</div>\n          <div class=\"faith-name\">Yvaine</div>\n          <div class=\"faith-details\">\n            <p>Goddess of starlight and fortune, consulted before every voyage and every gamble worth making.</p>\n          </div>\n        </div><h2>Personality</h2>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Persona &amp; Values</div>\n        <div class=\"card-value\" style=\"margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.25rem;\">\n          <p><strong>Defining trait:</strong> Gentle and nurturing</p><p><strong>Values most:</strong> Loyalty and trustworthiness</p><p><strong>Most valued object:</strong> A letter or journal from a loved one</p><p><strong>If it were lost:</strong> They deny it happened, pretending nothing is wrong.</p><p><strong>Greatest fear:</strong> Losing freedom or being imprisoned</p><p><strong>Person they value most:</strong> A leader or hero they admire</p><p><strong>Quirk:</strong> Is convinced one party member is secretly royalty (no matter the evidence).</p>\n        <div class=\"personality-trait-pairs\" style=\"margin-top: 0.75rem; border-top: 1px solid rgba(201, 160, 84, 0.15); padding-top: 0.5rem;\">\n          <strong style=\"font-size: 0.75rem; text-transform: uppercase; color: var(--dnd5e-color-gold-dim, #9a7d2e); letter-spacing: 0.05em;\">Trait Pairs</strong>\n          <ul style=\"margin: 0.25rem 0 0; padding-left: 1.25rem; font-size: 0.85rem;\">\n            <li><strong>Amorous / Chaste:</strong> 5 / 15</li><li><strong>Forgiving / Vengeful:</strong> 11 / 9</li><li><strong>Generous / Selfish:</strong> 5 / 15</li><li><strong>Honest / Deceitful:</strong> 3 / 17</li><li><strong>Just / Arbitrary:</strong> 18 / 2</li><li><strong>Merciful / Cruel:</strong> 14 / 6</li><li><strong>Modest / Proud:</strong> 19 / 1</li><li><strong>Prudent / Reckless:</strong> 2 / 18</li><li><strong>Temperate / Indulgent:</strong> 9 / 11</li><li><strong>Trusting / Suspicious:</strong> 16 / 4</li>\n          </ul>\n        </div>\n        </div>\n      </div><h2>Life Events</h2><div class=\"wicked-event-grid\">\n        <div class=\"wicked-event-card is-unlucky\">\n          <div class=\"event-title\">Event 1</div>\n          <div class=\"event-header\">\n            <span class=\"event-tag-pill\">Unlucky Event</span>\n          </div>\n          <div class=\"event-text\" style=\"margin-top: 0.5rem;\">\n            Lost access to a rare skill or magical ability\n          </div>\n        </div>\n        <div class=\"wicked-event-card is-lucky\">\n          <div class=\"event-title\">Event 2</div>\n          <div class=\"event-header\">\n            <span class=\"event-tag-pill\">Lucky Event</span>\n          </div>\n          <div class=\"event-text\" style=\"margin-top: 0.5rem;\">\n            Found a magical scroll or spellbook\n          </div>\n        </div>\n        <div class=\"wicked-event-card is-lucky\">\n          <div class=\"event-title\">Event 3</div>\n          <div class=\"event-header\">\n            <span class=\"event-tag-pill\">Lucky Event</span>\n          </div>\n          <div class=\"event-text\" style=\"margin-top: 0.5rem;\">\n            Discovered a rare ingredient or artifact sought by many\n          </div>\n        </div></div>"
      },
      "icon-override": "fas fa-book-skull"
    },
