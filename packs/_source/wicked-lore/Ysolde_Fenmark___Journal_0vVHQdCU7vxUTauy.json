  "flags": {
    "campaign-codex": {
      "type": "backstory",
      "data": {
        "description": "<h2>Family</h2><div class=\"wicked-family-grid\">\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Social Standing</div>\n        <div class=\"card-value\">Tavern-keepers or innkeepers known locally.</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Childhood</div>\n        <div class=\"card-value\">Was tutored by a mentor or wizard in a specialized skill</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Parents Status</div>\n        <div class=\"card-value\">Both alive and well.</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Family Standing</div>\n        <div class=\"card-value\">At risk — Crops have failed three seasons in a row, and famine looms.</div>\n      </div>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Family Goal</div>\n        <div class=\"card-value\">Avenge an ancestor who was betrayed and slain.</div>\n      </div></div>\n    <div class=\"wicked-parent-grid\">\n      <div class=\"wicked-parent-card\">\n        <div class=\"parent-role\">Mother</div>\n        <div class=\"parent-name\">Uvara</div>\n        <div class=\"parent-details\">\n          <p><strong>Relationship/Bond:</strong> You love and care for each other equally</p>\n        </div>\n      </div>\n      <div class=\"wicked-parent-card\">\n        <div class=\"parent-role\">Father</div>\n        <div class=\"parent-name\">Caerin</div>\n        <div class=\"parent-details\">\n          <p><strong>Relationship/Bond:</strong> You love and care for each other equally</p>\n        </div>\n      </div>\n    </div><p><strong>Birth order:</strong> 5th of 7 children.</p><div class=\"wicked-sibling-grid\">\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Raelin</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">1st Child</span>\n              <span class=\"sibling-tag-pill\">older brother</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling is your bitter rival, competing for inheritance or glory.</p>\n              <p><strong>Relationship:</strong> You love and care for each other equally</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Uvara</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">2nd Child</span>\n              <span class=\"sibling-tag-pill\">older sister</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling has sworn vengeance against your family for a perceived betrayal.</p>\n              <p><strong>Relationship:</strong> You have a strange co-dependent relationship</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card is-dead\">\n            <div class=\"sibling-name\">Faelorn</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">3rd Child</span>\n              <span class=\"sibling-tag-pill\">older brother</span> <span class=\"sibling-tag-pill dead\">deceased</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling is a devoted cleric of a powerful love, war, or law god.</p>\n              <p><strong>Relationship:</strong> You care for them more than they care for you</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card is-dead\">\n            <div class=\"sibling-name\">Mira</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">4th Child</span>\n              <span class=\"sibling-tag-pill\">older sister</span> <span class=\"sibling-tag-pill dead\">deceased</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling constantly outshines you.</p>\n              <p><strong>Relationship:</strong> You are estranged and don't speak to each other</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Freya</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">6th Child</span>\n              <span class=\"sibling-tag-pill\">younger sister</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling vanished years ago. All they left was a blank journal and frayed purple ribbon.</p>\n              <p><strong>Relationship:</strong> You love and care for each other equally</p>\n            </div>\n          </div>\n          <div class=\"wicked-sibling-card\">\n            <div class=\"sibling-name\">Sylvara</div>\n            <div class=\"sibling-header\">\n              <span class=\"sibling-ordinal\">7th Child</span>\n              <span class=\"sibling-tag-pill\">younger sister</span>\n            </div>\n            <div class=\"sibling-details\" style=\"margin-top: 0.5rem;\">\n              <p><strong>Occupation/Status:</strong> This sibling is always the center of a typhoon of trouble.</p>\n              <p><strong>Relationship:</strong> You have a strange co-dependent relationship</p>\n            </div>\n          </div></div><h2>Friends &amp; Enemies</h2><h3>Friends</h3><div class=\"wicked-fe-grid\">\n      <div class=\"wicked-fe-card is-friend\">\n        <div class=\"fe-name\">Lireth Lightwood</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">female</span> <span class=\"fe-tag-pill\">Dragonborn / Draconic Humanoid</span> <span class=\"fe-tag-pill\">Bounty Hunter</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> One friend disappeared mysteriously years ago.</p>\n        </div>\n      </div>\n      <div class=\"wicked-fe-card is-friend\">\n        <div class=\"fe-name\">Raevon Pinecrest</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">male</span> <span class=\"fe-tag-pill\">Dragonborn / Draconic Humanoid</span> <span class=\"fe-tag-pill\">Merchant / Smuggler</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> A childhood friend joined a secretive faction.</p>\n        </div>\n      </div>\n      <div class=\"wicked-fe-card is-friend\">\n        <div class=\"fe-name\">Xaela Coldwater</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">female</span> <span class=\"fe-tag-pill\">Monster-Humanoid Hybrid (Chimera, Lycanthrope, etc.)</span> <span class=\"fe-tag-pill\">Bandit / Highwayman</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> Your friend vanished into another plane during a magical accident.</p>\n        </div>\n      </div></div><h3>Enemies</h3><div class=\"wicked-fe-grid\">\n      <div class=\"wicked-fe-card is-enemy\">\n        <div class=\"fe-name\">Alardin Pinedorn</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">male</span> <span class=\"fe-tag-pill\">Goblin</span> <span class=\"fe-tag-pill\">Bard/Singer</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> A corrupt city official wants you silenced.</p>\n        </div>\n      </div>\n      <div class=\"wicked-fe-card is-enemy\">\n        <div class=\"fe-name\">Kessa Marshvale</div>\n        <div class=\"fe-header\"><span class=\"fe-tag-pill\">female</span> <span class=\"fe-tag-pill\">Tiefling / Fiend-Blooded</span> <span class=\"fe-tag-pill\">Mercenary / Soldier-for-hire</span></div>\n        <div class=\"fe-details\" style=\"margin-top: 0.5rem;\">\n          <p><strong>Situation:</strong> A former adventuring companion blames you for a failed quest.</p>\n        </div>\n      </div></div><h2>Romance</h2>\n      <div class=\"wicked-family-grid\">\n        <div class=\"wicked-family-card\">\n          <div class=\"card-label\">Romance Status</div>\n          <div class=\"card-value\"><strong>Currently in a healthy romance</strong> — A mysterious stranger saves you, and your bond blossoms into love.</div>\n        </div>\n      </div>\n        <div class=\"wicked-partner-card\">\n          <div class=\"partner-role\">Lover</div>\n          <div class=\"partner-name\">Wyra Sandholm</div>\n          <div class=\"partner-header\"><span class=\"partner-tag-pill\">female</span> <span class=\"partner-tag-pill\">Dwarf</span> <span class=\"partner-tag-pill\">Priest / Fanatical Cleric</span></div>\n          <div class=\"partner-details\" style=\"margin-top: 0.5rem;\">\n            <p><strong>Appearance:</strong> Golden skin with faint shimmering marks visible in moonlight.</p>\n          </div>\n        </div><h2>Faith</h2>\n        <div class=\"wicked-faith-card\">\n          <div class=\"faith-role\">Deity</div>\n          <div class=\"faith-name\">Gorst</div>\n          <div class=\"faith-details\">\n            <p>God of labor and endurance, patron of miners, soldiers, and everyone who suffers without complaining about it.</p>\n          </div>\n        </div><h2>Personality</h2>\n      <div class=\"wicked-family-card\">\n        <div class=\"card-label\">Persona &amp; Values</div>\n        <div class=\"card-value\" style=\"margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.25rem;\">\n          <p><strong>Defining trait:</strong> Honorable and principled</p><p><strong>Values most:</strong> Family and loved ones</p><p><strong>Most valued object:</strong> A religious or sacred artifact</p><p><strong>If it were lost:</strong> They experience nightmares or visions tied to the loss.</p><p><strong>Greatest fear:</strong> Pain or suffering (physical or emotional)</p><p><strong>Person they value most:</strong> A close childhood friend</p><p><strong>Quirk:</strong> Believes their shadow sometimes moves independently.</p>\n        <div class=\"personality-trait-pairs\" style=\"margin-top: 0.75rem; border-top: 1px solid rgba(201, 160, 84, 0.15); padding-top: 0.5rem;\">\n          <strong style=\"font-size: 0.75rem; text-transform: uppercase; color: var(--dnd5e-color-gold-dim, #9a7d2e); letter-spacing: 0.05em;\">Trait Pairs</strong>\n          <ul style=\"margin: 0.25rem 0 0; padding-left: 1.25rem; font-size: 0.85rem;\">\n            <li><strong>Amorous / Chaste:</strong> 9 / 11</li><li><strong>Forgiving / Vengeful:</strong> 8 / 12</li><li><strong>Generous / Selfish:</strong> 1 / 19</li><li><strong>Honest / Deceitful:</strong> 2 / 18</li><li><strong>Just / Arbitrary:</strong> 5 / 15</li><li><strong>Merciful / Cruel:</strong> 7 / 13</li><li><strong>Modest / Proud:</strong> 10 / 10</li><li><strong>Prudent / Reckless:</strong> 19 / 1</li><li><strong>Temperate / Indulgent:</strong> 15 / 5</li><li><strong>Trusting / Suspicious:</strong> 3 / 17</li>\n          </ul>\n        </div>\n        </div>\n      </div><h2>Life Events</h2><div class=\"wicked-event-grid\">\n        <div class=\"wicked-event-card is-lucky\">\n          <div class=\"event-title\">Event 1</div>\n          <div class=\"event-header\">\n            <span class=\"event-tag-pill\">Lucky Event</span>\n          </div>\n          <div class=\"event-text\" style=\"margin-top: 0.5rem;\">\n            Found an enchanted item that enhances a skill\n          </div>\n        </div>\n        <div class=\"wicked-event-card is-unlucky\">\n          <div class=\"event-title\">Event 2</div>\n          <div class=\"event-header\">\n            <span class=\"event-tag-pill\">Unlucky Event</span>\n          </div>\n          <div class=\"event-text\" style=\"margin-top: 0.5rem;\">\n            Caught in a raid, lost everything they owned\n          </div>\n        </div>\n        <div class=\"wicked-event-card is-unlucky\">\n          <div class=\"event-title\">Event 3</div>\n          <div class=\"event-header\">\n            <span class=\"event-tag-pill\">Unlucky Event</span>\n          </div>\n          <div class=\"event-text\" style=\"margin-top: 0.5rem;\">\n            Forced to abandon a mentor or teacher in danger\n          </div>\n        </div></div>"
      },
      "icon-override": "fas fa-book-skull"
    },
