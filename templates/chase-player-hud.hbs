<div class="chase-player-hud" style="display: flex; flex-direction: column; gap: 0.6rem; padding: 0.5rem;">

    <div style="text-align: center; padding: 0.3rem 0.5rem; background: rgba(0, 0, 0, 0.15); border: 1px solid rgba(201, 160, 84, 0.2); border-radius: 4px;">
        <span style="font-size: 0.8rem; font-weight: bold; color: #c9a054; text-transform: uppercase;">Round {{round}}</span>
    </div>

    <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.25rem;">
        {{#each turns}}
        <li style="display: flex; align-items: center; gap: 0.4rem; padding: 0.3rem 0.5rem; background: {{#if this.isCurrentTurn}}rgba(201, 160, 84, 0.12){{else}}transparent{{/if}}; border-radius: 3px;">
            {{#if this.isCurrentTurn}}<i class="fa-solid fa-caret-right" style="color: #c9a054;"></i>{{else}}<span style="width: 14px; display: inline-block;"></span>{{/if}}
            <span style="font-size: 0.85rem; color: {{#if this.isCurrentTurn}}#fff{{else}}#a89a82{{/if}}; font-weight: {{#if this.isCurrentTurn}}bold{{else}}normal{{/if}};">{{this.name}}</span>
        </li>
        {{/each}}
    </ul>

    {{#if needsInitiative}}
    <button type="button" data-action="rollInitiative" style="width: 100%; padding: 6px 12px; font-size: 0.85rem; cursor: pointer; background: rgba(0, 0, 0, 0.15); border: 1px solid rgba(201, 160, 84, 0.3); border-radius: 4px; color: #c9a054;">
        <i class="fa-solid fa-dice-d20"></i> Roll My Initiative
    </button>
    {{/if}}

    {{#if hasOwnCombatant}}
    {{#unless isQuarry}}
    <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-size: 0.72rem; color: #a89a82; text-transform: uppercase;">Gap to Quarry</span>
        <span style="flex: 1; text-align: right; font-family: monospace; font-size: 0.95rem; color: #fff;">{{gap}} ft</span>
    </div>
    {{/unless}}

    <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-size: 0.72rem; color: #a89a82; text-transform: uppercase; width: 4rem;">Exertion</span>
        <div style="flex: 1; height: 6px; background: rgba(255,255,255,0.08); border-radius: 3px; overflow: hidden;">
            <div style="height: 100%; width: {{dashesUsed}}0%; max-width: 100%; background: #c9a054;"></div>
        </div>
        <span style="font-family: monospace; font-size: 0.75rem; color: #a89a82; white-space: nowrap;">{{dashesUsed}}/{{dashThreshold}}</span>
    </div>
    {{/if}}

    {{#if lastComplication}}
    <div class="wicked-widget-card" style="padding: 0.5rem 0.6rem; font-size: 0.82rem; color: #d5d5d5;">
        <div style="font-size: 0.72rem; font-weight: bold; color: #c9a054; text-transform: uppercase; margin-bottom: 0.25rem;">
            <i class="fa-solid fa-triangle-exclamation"></i> Complication
        </div>
        {{{lastComplication}}}
    </div>
    {{/if}}

</div>
