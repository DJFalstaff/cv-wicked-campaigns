<div class="drama-player-hud" style="display: flex; flex-direction: column; gap: 0.6rem; padding: 0.5rem;">

    <div style="text-align: center; padding: 0.3rem 0.5rem; background: rgba(0, 0, 0, 0.15); border: 1px solid rgba(201, 160, 84, 0.2); border-radius: 4px;">
        <span style="font-size: 0.85rem; font-weight: bold; color: #c9a054; text-transform: uppercase;">{{sceneName}}</span>
        <div style="font-size: 0.72rem; color: #a89a82;">Round {{round}}</div>
    </div>

    <ul class="drama-hud-turn-list" style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.25rem;">
        {{#each turns}}
        <li style="display: flex; align-items: center; gap: 0.4rem; padding: 0.3rem 0.5rem; background: {{#if this.isCurrentTurn}}rgba(201, 160, 84, 0.12){{else}}transparent{{/if}}; border-radius: 3px;">
            {{#if this.isCurrentTurn}}<i class="fa-solid fa-caret-right" style="color: #c9a054;"></i>{{else}}<span style="width: 14px; display: inline-block;"></span>{{/if}}
            <span style="font-size: 0.85rem; color: {{#if this.isCurrentTurn}}#fff{{else}}#a89a82{{/if}}; font-weight: {{#if this.isCurrentTurn}}bold{{else}}normal{{/if}};">{{this.name}}</span>
        </li>
        {{/each}}
    </ul>

    {{#if needsInitiative}}
    <button type="button" data-action="rollInitiative" style="width: 100%; padding: 6px 12px; font-size: 0.85rem; cursor: pointer; background: rgba(0, 0, 0, 0.15); border: 1px solid rgba(201, 160, 84, 0.3); border-radius: 4px; color: #c9a054;">
        <i class="fa-solid fa-dice-d20"></i> Roll My Initiative
    </button>
    {{/if}}

    {{#if hasPendingCheck}}
    <button type="button" data-action="rollPendingCheck" style="width: 100%; padding: 8px 12px; font-size: 0.9rem; font-weight: bold; cursor: pointer; background: rgba(201, 160, 84, 0.15); border: 1px solid rgba(201, 160, 84, 0.5); border-radius: 4px; color: #c9a054; animation: drama-pending-pulse 2s ease-in-out infinite;">
        <i class="fa-solid fa-dice-d20"></i> Roll {{pendingCheck.skillLabel}} (DC {{pendingCheck.dc}}, {{pendingCheck.modeLabel}})
    </button>
    {{/if}}

    <div class="drama-hud-npc-list" style="display: flex; flex-direction: column; gap: 0.4rem; flex: 1; min-height: 0; overflow-y: auto;">
        {{#unless hasNpcs}}
        <p style="font-size: 0.78rem; color: #a89a82; font-style: italic;">No one to talk to yet.</p>
        {{/unless}}

        {{#each npcs}}
        <div style="display: flex; flex-direction: column; gap: 0.3rem; padding: 0.4rem 0.5rem; background: rgba(0, 0, 0, 0.15); border: 1px solid rgba(201, 160, 84, 0.15); border-radius: 4px;">
            <div style="display: flex; align-items: center; gap: 0.4rem;">
                <img src="{{this.img}}" style="width: 22px; height: 22px; border-radius: 4px; object-fit: cover;" />
                <span style="flex: 1; font-size: 0.85rem; font-weight: bold; color: #fff;">{{this.name}}</span>
                <div style="display: flex; gap: 2px;">
                    {{#each this.successPips}}
                    <i class="fa-solid fa-circle" style="font-size: 0.5rem; color: {{#if this}}#4caf50{{else}}rgba(255,255,255,0.15){{/if}};"></i>
                    {{/each}}
                    <span style="width: 4px;"></span>
                    {{#each this.failurePips}}
                    <i class="fa-solid fa-circle" style="font-size: 0.5rem; color: {{#if this}}#f44336{{else}}rgba(255,255,255,0.15){{/if}};"></i>
                    {{/each}}
                </div>
            </div>
            {{#if this.motives.length}}
            <div style="display: flex; flex-wrap: wrap; gap: 0.3rem;">
                {{#each this.motives}}
                <span style="display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.7rem; padding: 1px 6px; background: rgba(201,160,84,0.1); border-radius: 3px; color: #c9a054;">
                    {{this.label}}
                    {{#if this.isFullyRevealed}}
                    <span style="font-family: monospace; color: #fff;">{{this.value}}</span>
                    {{else}}
                    <i class="fa-solid fa-lock" style="font-size: 0.6rem; opacity: 0.7;"></i>
                    {{/if}}
                </span>
                {{/each}}
            </div>
            {{/if}}
        </div>
        {{/each}}
    </div>

</div>
