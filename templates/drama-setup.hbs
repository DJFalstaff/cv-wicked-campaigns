<form class="drama-setup-form" style="display: flex; flex-direction: column; gap: 0.75rem; padding: 0.5rem;" onsubmit="event.preventDefault();">
    {{#unless hasParticipants}}
    <p style="color: #d5a5a5; font-size: 0.85rem;">
        No tokens found. Select the PC and NPC tokens that should be part of the scene on the canvas, then reopen this dialog.
    </p>
    {{/unless}}

    {{#if hasPresets}}
    <div style="display: flex; flex-direction: column; gap: 0.25rem;">
        <label style="font-size: 0.8rem; font-weight: bold; color: #c9a054; text-transform: uppercase;">Load Preset</label>
        <div style="display: flex; gap: 0.4rem;">
            <select name="presetId" style="flex: 1; font-size: 0.85rem; padding: 4px 6px; background: rgba(0, 0, 0, 0.15); color: #fff; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 4px;">
                <option value="">— Select —</option>
                {{#each presets}}
                <option value="{{this.id}}" {{#if this.isLoaded}}selected{{/if}}>{{this.name}}</option>
                {{/each}}
            </select>
            <button type="button" data-action="loadPreset" style="padding: 4px 10px; background: rgba(0, 0, 0, 0.15); border: 1px solid rgba(201, 160, 84, 0.2); border-radius: 4px; color: #c9a054; cursor: pointer;">Load</button>
            <button type="button" data-action="deletePreset" style="padding: 4px 10px; background: rgba(163, 74, 58, 0.12); border: 1px solid rgba(163, 74, 58, 0.35); border-radius: 4px; color: #e08a75; cursor: pointer;">Delete</button>
        </div>
        {{#if unmatchedCount}}
        <span style="font-size: 0.75rem; color: #e08a75;">{{unmatchedCount}} of {{presetParticipantCount}} preset participants not on this scene.</span>
        {{/if}}
    </div>
    {{/if}}

    <div style="display: flex; flex-direction: column; gap: 0.25rem;">
        <label style="font-size: 0.8rem; font-weight: bold; color: #c9a054; text-transform: uppercase;">Scene Name</label>
        <input type="text" name="sceneName" value="{{sceneName}}" placeholder="e.g. The Duskmere Masquerade" style="width: 100%; font-size: 0.9rem; padding: 5px 7px; background: rgba(0, 0, 0, 0.15); color: #fff; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 4px;">
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.25rem;">
        <label style="font-size: 0.8rem; font-weight: bold; color: #6fae7c; text-transform: uppercase;">Player Characters</label>
        <div style="display: flex; flex-direction: column; gap: 0.25rem; max-height: 150px; overflow-y: auto;">
            {{#unless hasPcs}}
            <span style="font-size: 0.78rem; color: #a89a82; font-style: italic;">No PC tokens on this scene.</span>
            {{/unless}}
            {{#each pcs}}
            <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.5rem; background: rgba(0, 0, 0, 0.15); border: 1px solid rgba(111, 174, 124, 0.2); border-radius: 4px; font-size: 0.85rem; color: #fff; cursor: pointer;">
                <input type="checkbox" name="pc" value="{{this.id}}" {{#if this.included}}checked{{/if}}>
                {{this.name}}
            </label>
            {{/each}}
        </div>
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.25rem;">
        <label style="font-size: 0.8rem; font-weight: bold; color: #c9a054; text-transform: uppercase;">NPCs Present</label>
        <div style="display: flex; flex-direction: column; gap: 0.25rem; max-height: 150px; overflow-y: auto;">
            {{#unless hasNpcs}}
            <span style="font-size: 0.78rem; color: #a89a82; font-style: italic;">No NPC tokens on this scene.</span>
            {{/unless}}
            {{#each npcs}}
            <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.5rem; background: rgba(0, 0, 0, 0.15); border: 1px solid rgba(201, 160, 84, 0.15); border-radius: 4px; font-size: 0.85rem; color: #fff; cursor: pointer;">
                <input type="checkbox" name="npc" value="{{this.id}}" {{#if this.included}}checked{{/if}}>
                {{this.name}}
            </label>
            {{/each}}
        </div>
    </div>

    <button type="button" class="qbw-btn qbw-primary" data-action="start" style="width: 100%; font-weight: bold; padding: 6px 12px; font-size: 0.9rem; cursor: pointer; background: rgba(0, 0, 0, 0.15); border: 1px solid rgba(201, 160, 84, 0.3); border-radius: 4px; color: #c9a054;">
        <i class="fa-solid fa-masks-theater"></i> Start Drama Scene
    </button>

    <button type="button" data-action="saveAsPreset" style="width: 100%; padding: 6px 12px; font-size: 0.85rem; cursor: pointer; background: rgba(0, 0, 0, 0.15); border: 1px solid rgba(201, 160, 84, 0.2); border-radius: 4px; color: #a89a82;">
        <i class="fa-solid fa-bookmark"></i> Save as Preset
    </button>
</form>
