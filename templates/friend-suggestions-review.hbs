<div class="friend-suggestions-review-content" style="padding: 0.75rem; display: flex; flex-direction: column; gap: 0.6rem; height: 100%; overflow-y: auto;">
    {{#if items.length}}
    <div style="display: flex; gap: 0.4rem;">
        <button type="button" class="qbw-btn" data-action="acceptAll" style="flex: 1; padding: 5px 8px; font-size: 0.8rem;">
            <i class="fa-solid fa-check-double"></i> Accept All
        </button>
        <button type="button" class="qbw-btn" data-action="rejectAll" style="flex: 1; padding: 5px 8px; font-size: 0.8rem;">
            <i class="fa-solid fa-ban"></i> Reject All
        </button>
    </div>
    {{#each items}}
    <div class="wicked-suggestion-card" style="border: 1px solid rgba(201, 160, 84, 0.25); border-radius: 6px; padding: 0.6rem;">
        <div style="display: flex; align-items: baseline; gap: 0.4rem; margin-bottom: 0.4rem;">
            <div style="font-family: 'Cinzel', Georgia, serif; color: #c9a054; font-weight: bold;">{{this.name}}</div>
            <span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.03em; color: #888; border: 1px solid rgba(201, 160, 84, 0.3); border-radius: 3px; padding: 1px 5px;">{{this.sectionLabel}}</span>
        </div>
        <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.03em; color: #888; margin-bottom: 0.15rem;">Current</div>
        <div style="margin-bottom: 0.5rem; color: #ccc;">{{this.currentSituation}}</div>
        <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.03em; color: #888; margin-bottom: 0.15rem;">Proposed</div>
        <div style="margin-bottom: 0.6rem; color: #d7c9a0;">{{this.proposedSituation}}</div>
        <div style="display: flex; gap: 0.4rem;">
            <button type="button" class="qbw-btn" data-action="accept" data-section="{{this.section}}" data-index="{{this.index}}" style="flex: 1; padding: 4px 8px; font-size: 0.8rem;">
                <i class="fa-solid fa-check"></i> Accept
            </button>
            <button type="button" class="qbw-btn" data-action="reject" data-section="{{this.section}}" data-index="{{this.index}}" style="flex: 1; padding: 4px 8px; font-size: 0.8rem;">
                <i class="fa-solid fa-xmark"></i> Reject
            </button>
        </div>
    </div>
    {{/each}}
    {{else}}
    <p style="text-align: center; color: #999; font-style: italic;">No pending suggestions.</p>
    {{/if}}
</div>
