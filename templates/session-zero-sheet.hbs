<form class="session-zero-sheet-content" autocomplete="off" style="display: flex; flex-direction: column; gap: 0.75rem; padding: 0.75rem; height: 100%;">
    <div style="display: flex; align-items: center; justify-content: flex-end; gap: 0.4rem;">
        {{!-- Summaries created before shared notes shipped are still GM-only, so the table can't
              read them or add to them. Surfaced here rather than migrated automatically: a GM may
              have deliberately kept one private. --}}
        {{#if isGM}}
        {{#if sharedWithTable}}
        <span data-tooltip="Every player can read this summary and add their own notes" style="margin-right: auto; font-size: 0.75rem; color: #8fae8f;">
            <i class="fa-solid fa-users"></i> Shared with the table
        </span>
        {{else}}
        <span data-tooltip="Only the GM can see this summary" style="margin-right: auto; font-size: 0.75rem; color: #b58f6a;">
            <i class="fa-solid fa-user-lock"></i> GM only
        </span>
        <button type="button" class="qbw-btn" data-action="share" data-tooltip="Let every player read this summary and add their own notes" style="padding: 4px 10px; font-size: 0.8rem;">
            <i class="fa-solid fa-users"></i> Share with Table
        </button>
        {{/if}}
        {{/if}}
        <button type="button" class="qbw-btn" data-action="export-pdf" data-tooltip="Export this summary as a PDF" style="padding: 4px 10px; font-size: 0.8rem;">
            <i class="fa-solid fa-file-pdf"></i> Export PDF
        </button>
        {{#if editable}}
        <button type="button" class="qbw-btn" data-action="rename" data-tooltip="Rename this summary" style="padding: 4px 10px; font-size: 0.8rem;">
            <i class="fa-solid fa-pen"></i> Rename
        </button>
        {{/if}}
    </div>

    <div class="session-zero-entries" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 0.75rem;">
        {{#each entries}}
        <div class="session-zero-entry" style="display: flex; gap: 0.75rem; padding: 0.6rem; background: rgba(0, 0, 0, 0.15); border: 1px solid rgba(201, 160, 84, 0.15); border-radius: 6px;">
            <img src="{{this.cardImage}}" data-action="view-card-image" data-src="{{this.cardImage}}" data-title="{{this.cardName}}"
                 data-tooltip="Click to view full image"
                 style="width: 90px; aspect-ratio: 5 / 7; object-fit: cover; border-radius: 4px; border: 1px solid rgba(201, 160, 84, 0.3); flex-shrink: 0; cursor: pointer;">
            <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.35rem;">

                {{!-- The heading is what the table DECIDED, defaulting to the card's own name until
                      the GM writes something better. The card name is shown beside it so the
                      record still says which card produced this. --}}
                <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
                    <h4 style="margin: 0; font-family: 'Cinzel', Georgia, serif; color: #c9a054; font-size: 1.05rem;">
                        {{this.title}}
                        {{#if @root.isGM}}
                        <button type="button" class="qbw-btn" data-action="edit-title" data-entry-id="{{this.id}}"
                                data-tooltip="Set what the table decided about this card"
                                style="padding: 0 4px; font-size: 0.7rem; background: none; border: none; color: #8a7a5a;">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        {{/if}}
                    </h4>
                    <div style="display: flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; color: #b5b5b5; white-space: nowrap;">
                        {{#unless this.titleIsCardName}}<span style="color: #8a7a5a;">{{this.cardName}}</span>{{/unless}}
                        {{#if this.playerImg}}<img src="{{this.playerImg}}" style="width: 18px; height: 18px; border-radius: 50%; object-fit: cover;">{{/if}}
                        {{#if this.playerName}}<span data-tooltip="Whose turn this card came up on">{{this.playerName}}</span>{{/if}}
                        {{#if @root.isGM}}
                        <button type="button" class="qbw-btn" data-action="delete-entry" data-entry-id="{{this.id}}"
                                data-tooltip="Remove this card and everything written about it"
                                style="padding: 0 5px; font-size: 0.72rem; background: none; border: none; color: #8a6a6a;">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                        {{/if}}
                    </div>
                </div>

                {{#if this.linkedPlayers.length}}
                <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; font-size: 0.72rem; color: #a89a82;">
                    <span style="text-transform: uppercase; letter-spacing: 0.03em;">Involves</span>
                    {{#each this.linkedPlayers}}
                    <span style="display: flex; align-items: center; gap: 0.25rem; padding: 1px 8px 1px 2px; background: rgba(201,160,84,0.1); border: 1px solid rgba(201,160,84,0.25); border-radius: 999px;">
                        {{#if this.img}}<img src="{{this.img}}" style="width: 16px; height: 16px; border-radius: 50%; object-fit: cover;">{{/if}}
                        <span>{{this.name}}</span>
                    </span>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Every contribution is the same shape and sits at the same level. The GM's
                      words are one of these, not a headline the others hang beneath. --}}
                {{#if this.contributions.length}}
                <ul class="session-zero-contributions" style="list-style: none; margin: 0.15rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                    {{#each this.contributions}}
                    <li style="display: flex; flex-direction: column; gap: 0.15rem;">
                        <div style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.72rem; color: #a89a82;">
                            <i class="fa-solid fa-quote-left" style="color: {{#if this.authorColor}}{{this.authorColor}}{{else}}#c9a054{{/if}};"></i>
                            <b>{{this.authorName}}</b>
                            {{#if this.timestampLabel}}<span style="color: #777;">{{this.timestampLabel}}</span>{{/if}}
                            {{#if this.canDelete}}
                            <button type="button" class="qbw-btn" data-action="delete-contribution"
                                    data-entry-id="{{../id}}" data-contribution-id="{{this.id}}"
                                    data-tooltip="Delete this"
                                    style="margin-left: auto; padding: 0 5px; font-size: 0.7rem; background: none; border: none; color: #8a6a6a;">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                            {{/if}}
                        </div>
                        <div class="session-zero-contribution-html" style="font-size: 0.9rem; color: #d5d5d5;">{{{this.html}}}</div>
                    </li>
                    {{/each}}
                </ul>
                {{/if}}

                {{#if this.canContribute}}
                <div style="margin-top: auto; padding-top: 0.3rem;">
                    <button type="button" class="qbw-btn" data-action="add-contribution" data-entry-id="{{this.id}}"
                            data-tooltip="Add what you have to say about this card"
                            style="padding: 3px 9px; font-size: 0.75rem;">
                        <i class="fa-solid fa-pen-to-square"></i> Add Yours
                    </button>
                </div>
                {{/if}}
            </div>
        </div>
        {{else}}
        <div class="qbw-empty-note" style="text-align: center; padding: 1.5rem 1rem; color: #b5b5b5; font-style: italic; font-size: 0.9rem;">
            No answers recorded yet.
        </div>
        {{/each}}
    </div>
</form>
