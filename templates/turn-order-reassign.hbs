<div class="turn-order-reassign-content" style="padding: 0.75rem;">
    <p style="font-size: 0.8rem; color: #b5b5b5; margin-top: 0;">Drag to reorder. Turn order updates immediately.</p>
    <ul class="turn-order-list" style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem;">
        {{#each combatants}}
        <li data-combatant-id="{{this.id}}" draggable="true"
            style="display: flex; align-items: center; gap: 0.6rem; padding: 0.4rem 0.6rem; background: {{#if this.isCurrentTurn}}rgba(201, 160, 84, 0.18){{else}}rgba(0, 0, 0, 0.15){{/if}}; border: 1px solid {{#if this.isCurrentTurn}}#c9a054{{else}}rgba(201, 160, 84, 0.15){{/if}}; border-radius: 4px; cursor: grab;">
            <i class="fa-solid fa-grip-lines" style="color: #888;"></i>
            <img src="{{this.img}}" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(201, 160, 84, 0.3);">
            {{#if this.isCurrentTurn}}
            <i class="fa-solid fa-caret-right" style="color: #c9a054;" data-tooltip="Current turn"></i>
            {{/if}}
            <span style="flex: 1; font-family: 'Signika', sans-serif; color: #fff;">{{this.name}}</span>
            {{#if this.isPC}}
            <span style="font-size: 0.75rem; color: #9ab0c9; white-space: nowrap;" data-tooltip="Major Arcana recorded / max per player">
                <i class="fa-solid fa-star"></i> {{this.arcanaCount}}{{#if this.arcanaMax}}/{{this.arcanaMax}}{{/if}}
            </span>
            <span style="font-size: 0.75rem; color: #d99cae; white-space: nowrap;" data-tooltip="Rose cards recorded / max per player">
                <i class="fa-solid fa-fan"></i> {{this.rosesCount}}{{#if this.rosesMax}}/{{this.rosesMax}}{{/if}}
            </span>
            {{/if}}
            <span style="font-size: 0.8rem; color: #c9a054; font-weight: bold;">{{this.initiative}}</span>
        </li>
        {{else}}
        <li class="qbw-empty-note" style="text-align: center; padding: 1rem; color: #b5b5b5; font-style: italic; font-size: 0.85rem;">
            No combatants in this encounter.
        </li>
        {{/each}}
    </ul>

    <div style="display: flex; gap: 0.4rem; margin-top: 0.6rem;">
        <button type="button" class="qbw-btn" data-action="previousTurn" style="flex: 1; padding: 5px 8px; font-size: 0.8rem;">
            <i class="fa-solid fa-caret-left"></i> Previous
        </button>
        <button type="button" class="qbw-btn" data-action="nextTurn" style="flex: 1; padding: 5px 8px; font-size: 0.8rem;">
            Next <i class="fa-solid fa-caret-right"></i>
        </button>
    </div>

    {{#if hasLimits}}
    <div class="session-zero-tier-trackers" style="margin-top: 0.75rem; padding-top: 0.6rem; border-top: 1px solid rgba(201, 160, 84, 0.2); display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.8rem; color: #d5d5d5;">
        <div style="display: flex; justify-content: space-between;">
            <span><i class="fa-solid fa-skull" style="color: #c9a054;"></i> Villain</span>
            <span>{{villainCount}} / {{villainMax}}</span>
        </div>
        <div style="display: flex; justify-content: space-between;">
            <span><i class="fa-solid fa-moon" style="color: #c9a054;"></i> Moons</span>
            <span>{{moonsCount}} / {{moonsMax}}</span>
        </div>
        <div style="display: flex; justify-content: space-between;">
            <span><i class="fa-solid fa-infinity" style="color: #c9a054;"></i> Mobius</span>
            <span>{{mobiusCount}} / {{mobiusMax}}</span>
        </div>
    </div>
    {{/if}}

    <button type="button" class="qbw-btn" data-action="endSession" style="margin-top: 0.75rem; width: 100%; padding: 6px 10px; font-size: 0.85rem;">
        <i class="fa-solid fa-flag-checkered"></i> End Session
    </button>
</div>
